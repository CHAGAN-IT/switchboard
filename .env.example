# Switchboard environment variables
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/switchboard
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/switchboard_test
DB_ECHO=false

# Auth -- JWT secret for operator API (must be >= 32 bytes in production)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
OPERATOR_JWT_SECRET=change-me-operator-secret-min-32bytes

# Auth -- JWT secret for customer-facing gateway (must be >= 32 bytes in production)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
CUSTOMER_JWT_SECRET=change-me-customer-secret-min-32bytes
